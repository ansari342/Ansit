{
  "expo": {
    "name": "Ansit",
    "slug": "ansit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080b11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahsanansari.ansit",
      "buildNumber": "7",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080b11"
      },
      "package": "com.ahsanansari.ansit",
      "versionCode": 1,
      "permissions": [
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "3abd66eb-1a11-4070-8731-23861f5546eb"
      }
    },
    "owner": "ansari342",
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/UthmanicHafs.ttf",
            "./assets/fonts/AmiriQuran.ttf"
          ]
        }
      ],
      "expo-status-bar"
    ]
  }
}
